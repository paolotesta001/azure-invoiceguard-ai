# Non-secret settings only. Copy to .env and adjust.
# mock  = no Azure calls (recorded Document Intelligence responses, deterministic mock LLM)
# azure = real Document Intelligence + Azure OpenAI in Foundry (needs `pip install -e ".[azure]"` and `az login`)
INVOICEGUARD_MODE=mock
# memory = no database (quick look). sql = PostgreSQL via SQLAlchemy.
INVOICEGUARD_STORAGE=sql
# Local Docker Postgres only. In Azure, the app authenticates with Microsoft Entra ID (v4).
INVOICEGUARD_DATABASE_URL=postgresql+psycopg://invoiceguard:invoiceguard@localhost:5432/invoiceguard
# Mock ERP base URL. Leave empty to use the in-process payment gateway.
INVOICEGUARD_ERP_BASE_URL=http://localhost:8001
INVOICEGUARD_FILE_STORE_DIR=.data/files
INVOICEGUARD_CONFIG_PATH=config/settings.yaml
INVOICEGUARD_SEED_DIR=data/seed
INVOICEGUARD_INVOICES_DIR=data/invoices
INVOICEGUARD_RECORDINGS_DIR=data/recorded
# --- Azure mode only (endpoints are not secrets; auth uses DefaultAzureCredential) ---
# Single-service Document Intelligence resource (required for Entra ID auth)
INVOICEGUARD_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-di-resource>.cognitiveservices.azure.com/
# Foundry / Azure OpenAI resource endpoint and model deployment name
INVOICEGUARD_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
INVOICEGUARD_LLM_DEPLOYMENT=<your-deployment-name>
# Set to false to skip LLM explanations entirely (rules-only baseline)
INVOICEGUARD_LLM_ENABLED=true
